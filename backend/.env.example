# Optional: only for running the backend directly outside Docker Compose.
# Compose does not read backend/.env; it injects backend settings from the root compose.yaml.
API_PORT=3001
HOST=0.0.0.0
PGHOST=db
PGPORT=5432
PGUSER=studyforge
PGPASSWORD=replace-me
PGDATABASE=studyforge
# Alternatively use DATABASE_URL; do not set both.
# DATABASE_URL=postgresql://studyforge:password@db:5432/studyforge
FRONTEND_DIR=/app/empty-public
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
SESSION_TTL_SECONDS=604800
MERRIAM_WEBSTER_API_KEY=
