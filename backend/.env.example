# Cấu hình backend V1/SQLite; PostgreSQL V2 chưa được triển khai.
# Backend-only values. Never copy secrets or database paths into frontend/.env.
API_PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/studyforge.sqlite
FRONTEND_DIR=dist/frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SECURE_COOKIES=false
SESSION_TTL_SECONDS=604800
# Production: NODE_ENV=production, SECURE_COOKIES=true, HTTPS reverse proxy.
