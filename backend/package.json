{
  "name": "@studyforge/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "build": "npm run typecheck && esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "typecheck": "tsc --project tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@studyforge/contracts": "1.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  }
}
