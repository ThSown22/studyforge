# Docker Compose local only. Copy to .env at the project root; never commit the real .env.
STUDYFORGE_DB_PASSWORD=replace-with-a-long-random-url-safe-password
STUDYFORGE_HOST_FE_PORT=3000
STUDYFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STUDYFORGE_SESSION_TTL_SECONDS=604800
# Optional server-side dictionary key. Never expose this value to browser code.
STUDYFORGE_MERRIAM_WEBSTER_API_KEY=
# Optional server-side DeepL developer key for on-demand EN→VI definitions.
STUDYFORGE_DEEPL_API_KEY=
