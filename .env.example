# Legacy V1 Compose interpolation; PostgreSQL V2 is not configured yet.
# Each application has an isolated environment file.
# Copy backend/.env.example -> backend/.env
# Copy frontend/.env.example -> frontend/.env
# npm scripts load these files. Do not put secrets in the frontend environment.

# Optional Docker Compose interpolation only. Copy this root file to .env when
# changing these values; the app's npm scripts do not read root .env.
STUDYFORGE_HOST_FE_PORT=3000
STUDYFORGE_FE_PORT=3000
STUDYFORGE_API_PORT=3001
STUDYFORGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STUDYFORGE_SESSION_TTL_SECONDS=604800
