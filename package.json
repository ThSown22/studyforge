{
  "name": "studyforge",
  "version": "1.0.0",
  "private": true,
  "description": "StudyForge modular monorepo: TypeScript frontend và Node.js backend.",
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node --env-file-if-exists=backend/.env --watch --experimental-strip-types backend/src/main.ts",
    "dev:frontend": "node --env-file-if-exists=frontend/.env scripts/frontend-server.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=backend/.env scripts/start.mjs",
    "db:migrate": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/src/infrastructure/database/cli.ts migrate",
    "import:vocabulary": "node --env-file-if-exists=backend/.env --experimental-strip-types backend/src/modules/vocabulary/import/cli.ts",
    "test": "node scripts/test.mjs",
    "lint": "node scripts/check.mjs",
    "format:check": "node scripts/check.mjs --format-only",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  }
}
