# Optional: only for running the frontend directly outside Docker Compose.
# Compose does not read frontend/.env. Never put passwords, keys or backend secrets here.
FE_PORT=3000
FE_HOST=127.0.0.1
API_PROXY_TARGET=http://127.0.0.1:3001
# Empty means same-origin /api requests through the dev proxy or production server.
PUBLIC_API_BASE_URL=
